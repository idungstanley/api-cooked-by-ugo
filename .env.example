NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/cooked-by-ugo

# At least 32 random characters. Generate with: openssl rand -base64 48
JWT_SECRET=

# Comma-separated frontends allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
ADMIN_URL=http://localhost:5174

# Used only by `npm run seed`, for the three local staff accounts.
SEED_PASSWORD=

# Optional in development. All are required when NODE_ENV=production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BREVO_API_KEY=
EMAIL_FROM=orders@cookedbyugo.com
KITCHEN_EMAIL=
CLOUDINARY_URL=

# The customer site, for links in emails such as "Track your order" and "Rate your order".
SITE_URL=http://localhost:5173
# Stripe's publishable key (pk_...). Safe to share, and needed for the payment form at checkout.
STRIPE_PUBLISHABLE_KEY=
# Optional. Lists Royal Mail addresses for a postcode at checkout (ideal-postcodes.co.uk).
# Without it, customers type their street, and the postcode and city are still checked.
IDEAL_POSTCODES_API_KEY=
